APP_NAME=SARIFIO
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.sarifio.com

# sandbox = Test Mode (simulated providers, test ledger). Never "production" on staging.
SARIFIO_MODE=sandbox
# Staging only: returns the fresh random OTP to the test app. Production refuses to boot if true.
SANDBOX_OTP_REVEAL=true
OTP_DRIVER=log
OTP_CHANNELS=sms,whatsapp

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sarifio_staging
DB_USERNAME=sarifio
DB_PASSWORD=change-me

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis

LOG_CHANNEL=stack
LOG_LEVEL=info

# First admin for the dashboard API (seeded once; change the password after first sign-in).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="SARIFIO Admin"
