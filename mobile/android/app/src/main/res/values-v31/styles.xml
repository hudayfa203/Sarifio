<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash (Samsung One UI 4 and later). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/sarifio_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/sarifio_ink</item>
        <item name="android:statusBarColor">@color/sarifio_ink</item>
        <item name="android:navigationBarColor">@color/sarifio_ink</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/sarifio_ink</item>
    </style>
</resources>
